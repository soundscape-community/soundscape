#include "FeatureFlags-Release.xcconfig"

// `$(inherited)` - Feature flags defined in `FeatureFlags-Release.xcconfig`
OTHER_SWIFT_FLAGS = $(inherited)

// Optional OTLP logs configuration. No collector ships by default.
SOUNDSCAPE_OTEL_LOGS_ENDPOINT =
SOUNDSCAPE_OTEL_LOGS_HEADERS =

// Optional machine-local overrides (ignored by Git).
#include? "Local.xcconfig"
